#!/usr/bin/env python3

import cv2
import numpy as np
import rclpy
from rclpy.node import Node
from sensor_msgs.msg import CompressedImage
from sensor_msgs.msg import Image


class ImageRotateCompressNode(Node):
    def __init__(self):
        super().__init__("image_rotate_compress_node")

        input_topic = self.declare_parameter("input_topic", "/picam/image_raw").value
        output_topic = self.declare_parameter(
            "output_topic",
            "/picam/image_rotated/compressed",
        ).value
        self.rotation_degrees = int(self.declare_parameter("rotation_degrees", 90).value)
        self.jpeg_quality = int(self.declare_parameter("jpeg_quality", 80).value)
        self.output_width = int(self.declare_parameter("output_width", 0).value)
        self.output_height = int(self.declare_parameter("output_height", 0).value)
        self.resize_mode = self.declare_parameter("resize_mode", "none").value

        self.jpeg_quality = max(1, min(self.jpeg_quality, 100))
        self.pub = self.create_publisher(CompressedImage, output_topic, 10)
        self.sub = self.create_subscription(Image, input_topic, self.image_callback, 10)

        self.get_logger().info(
            "Rotating and compressing "
            f"{input_topic} to {output_topic}, "
            f"rotation={self.rotation_degrees} degrees, "
            f"jpeg_quality={self.jpeg_quality}, "
            f"output={self.output_width}x{self.output_height}, "
            f"resize_mode={self.resize_mode}"
        )

    def image_callback(self, msg):
        frame = self.image_msg_to_frame(msg)
        if frame is None:
            return

        frame = self.rotate_frame(frame)
        frame = self.resize_frame(frame)

        ok, encoded = cv2.imencode(
            ".jpg",
            frame,
            [int(cv2.IMWRITE_JPEG_QUALITY), self.jpeg_quality],
        )
        if not ok:
            self.get_logger().warn("JPEG encoding failed")
            return

        out = CompressedImage()
        out.header = msg.header
        out.format = "jpeg"
        out.data = encoded.tobytes()
        self.pub.publish(out)

    def image_msg_to_frame(self, msg):
        if msg.encoding not in ("rgb8", "bgr8", "mono8"):
            self.get_logger().warn(
                f"Unsupported image encoding '{msg.encoding}'. Supported: rgb8, bgr8, mono8."
            )
            return None

        channels = 1 if msg.encoding == "mono8" else 3
        if msg.step < msg.width * channels:
            self.get_logger().warn("Invalid image step")
            return None

        data = np.frombuffer(msg.data, dtype=np.uint8)
        frame = data.reshape((msg.height, msg.step // channels, channels))
        frame = frame[:, : msg.width].copy()

        if msg.encoding == "rgb8":
            frame = cv2.cvtColor(frame, cv2.COLOR_RGB2BGR)
        elif msg.encoding == "mono8":
            frame = cv2.cvtColor(frame[:, :, 0], cv2.COLOR_GRAY2BGR)

        return frame

    def rotate_frame(self, frame):
        if self.rotation_degrees == 0:
            return frame
        if self.rotation_degrees == 90:
            return cv2.rotate(frame, cv2.ROTATE_90_CLOCKWISE)
        if self.rotation_degrees == 180:
            return cv2.rotate(frame, cv2.ROTATE_180)
        if self.rotation_degrees == 270:
            return cv2.rotate(frame, cv2.ROTATE_90_COUNTERCLOCKWISE)

        self.get_logger().warn(
            f"Unsupported rotation_degrees={self.rotation_degrees}. Use 0, 90, 180, or 270."
        )
        return frame

    def resize_frame(self, frame):
        if self.output_width <= 0 or self.output_height <= 0 or self.resize_mode == "none":
            return frame

        if self.resize_mode == "stretch":
            return cv2.resize(
                frame,
                (self.output_width, self.output_height),
                interpolation=cv2.INTER_AREA,
            )

        if self.resize_mode != "crop":
            self.get_logger().warn(
                f"Unsupported resize_mode='{self.resize_mode}'. Use none, crop, or stretch."
            )
            return frame

        source_ratio = frame.shape[1] / frame.shape[0]
        target_ratio = self.output_width / self.output_height

        if source_ratio > target_ratio:
            crop_width = int(frame.shape[0] * target_ratio)
            x = (frame.shape[1] - crop_width) // 2
            frame = frame[:, x : x + crop_width]
        else:
            crop_height = int(frame.shape[1] / target_ratio)
            y = (frame.shape[0] - crop_height) // 2
            frame = frame[y : y + crop_height, :]

        return cv2.resize(
            frame,
            (self.output_width, self.output_height),
            interpolation=cv2.INTER_AREA,
        )


def main():
    rclpy.init()
    node = ImageRotateCompressNode()
    try:
        rclpy.spin(node)
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main()
