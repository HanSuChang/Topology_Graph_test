+            }
+            transition_rc_car_start(RcCarStartState::TurnCwToLoading);
+            return PwmCommand{0, 0};
+          }
+          const double target_heading =
+            std::atan2(intersection_1_y_ - follower.y, intersection_1_x_ - follower.x);
+          const double heading_error = normalize_angle(target_heading - follower.yaw);
+          return apply_turn_to_pwm(
+            rc_car_start_forward_pwm_,
+            heading_error,
+            rc_car_start_drive_turn_pwm_delta_);
+        }
+      case RcCarStartState::TurnCwToLoading: {
+          if (!rc_car_start_turn_target_yaw_.has_value()) {
+            rc_car_start_turn_target_yaw_ =
+              normalize_angle(follower.yaw - std::abs(rc_car_start_turn_radians_));
+          }
+          const double heading_error =
+            normalize_angle(rc_car_start_turn_target_yaw_.value() - follower.yaw);
+          if (std::abs(heading_error) <= rc_car_start_yaw_tolerance_) {
+            rc_car_start_turn_target_yaw_.reset();
+            transition_rc_car_start(RcCarStartState::DriveToLoading);
+            return PwmCommand{0, 0};
+          }
+          return make_rc_car_start_turn_command(heading_error);
+        }
+      case RcCarStartState::DriveToLoading: {
+          const Pose2D start_target = rc_car_start_target_pose();
+          const double target_heading =
+            std::atan2(start_target.y - follower.y, start_target.x - follower.x);
+          const double heading_error = normalize_angle(target_heading - follower.yaw);
+          const double distance = distance_to_target(follower, start_target.x, start_target.y);
+          if (distance <= rc_car_start_loading_tolerance_) {
+            begin_rc_car_return_final_turn(follower);
+            return PwmCommand{0, 0};
+          }
+          if (std::abs(heading_error) > rc_car_start_yaw_tolerance_) {
+            return make_rc_car_start_turn_command(heading_error);
+          }
+          const int forward_pwm =
+            distance <= rc_car_start_loading_slow_distance_ ?
+            rc_car_start_loading_slow_pwm_ : rc_car_start_forward_pwm_;
+          return apply_turn_to_pwm(
+            forward_pwm,
+            heading_error,
+            rc_car_start_drive_turn_pwm_delta_);
+        }
+      case RcCarStartState::TurnCw180AtLoading: {
+          const Pose2D start_target = rc_car_start_target_pose();
+          if (!rc_car_return_final_turn_last_yaw_.has_value()) {
+            rc_car_return_final_turn_last_yaw_ = follower.yaw;
+          }
+
+          const double delta_yaw =
+            normalize_angle(follower.yaw - rc_car_return_final_turn_last_yaw_.value());
+          rc_car_return_final_turn_last_yaw_ = follower.yaw;
+          if (delta_yaw < 0.0) {
+            rc_car_return_final_turn_rotated_ += -delta_yaw;
+          }
+
+          const double remaining =
+            std::abs(rc_car_return_final_turn_radians_) - rc_car_return_final_turn_rotated_;
+          if (remaining <= rc_car_return_final_turn_yaw_tolerance_) {
+            reset_rc_car_return_final_turn();
+            const double distance =
+              distance_to_target(follower, start_target.x, start_target.y);
+            if (distance > rc_car_start_loading_tolerance_) {
+              transition_rc_car_start(RcCarStartState::ReverseToStart);
+              return PwmCommand{0, 0};
+            }
+            transition_rc_car_start(RcCarStartState::Complete);
+            return PwmCommand{0, 0};
+          }
+          return PwmCommand{rc_car_return_final_turn_pwm_, -rc_car_return_final_turn_pwm_};
+        }
+      case RcCarStartState::ReverseToStart: {
+          const Pose2D start_target = rc_car_start_target_pose();
+          const double distance = distance_to_target(follower, start_target.x, start_target.y);
+          if (distance <= rc_car_start_loading_tolerance_) {
+            begin_rc_car_return_final_turn(follower);
+            return PwmCommand{0, 0};
+          }
+          const double reverse_heading =
+            std::atan2(start_target.y - follower.y, start_target.x - follower.x);
+          const double target_front_yaw = normalize_angle(reverse_heading + M_PI);
+          const double heading_error = normalize_angle(target_front_yaw - follower.yaw);
+          return apply_turn_to_pwm(
+            -rc_car_start_reverse_pwm_,
+            heading_error,
+            rc_car_start_drive_turn_pwm_delta_);
+        }
+      case RcCarStartState::Complete:
+        mode_ = FollowerMode::Stop;
+        rc_car_start_state_ = RcCarStartState::Inactive;
+        return PwmCommand{0, 0};
+    }
+    return PwmCommand{0, 0};
+  }
