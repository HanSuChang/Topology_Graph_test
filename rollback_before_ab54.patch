+    saved_rc_start_pose_ = Pose2D{follower.x, follower.y, normalize_angle(follower.yaw)};
+    RCLCPP_INFO(
+      this->get_logger(),
+      "Saved RC car start pose near loading: x=%.3f y=%.3f yaw=%.3f distance=%.3f tolerance=%.3f",
